            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List personal access tokens for a user"
        },
        {
          "info": {
            "name": "Create a personal access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}/api/v3/users/:userId/tokens",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a personal access token"
        }
      ]
    }
